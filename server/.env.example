# Copy this file to .env (git-ignored) and fill in the blanks.
# Keep every value out of git, chats and screenshots.
#
# Only the four marked REQUIRED are needed to run the server. Everything below
# them has a working default, and is here so you can see what can be tuned
# without reading the code. Limits are explained in docs/load.md.

# ============================================================================
# REQUIRED
# ============================================================================

# --- Firebase: checking sign-ins --------------------------------------------
# Console -> Project settings -> Service accounts -> Generate new private key.
# Save the downloaded file as server/secrets/firebase-service-account.json.
# This is the path to it, not the key itself.
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json

# --- Database: accounts -----------------------------------------------------
# console.neon.tech -> your project -> Connection string (pooled).
# Looks like: postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Transcription ----------------------------------------------------------
# console.groq.com -> API keys. Starts with gsk_.
GROQ_API_KEY=

# --- Audio storage (AWS S3) -------------------------------------------------
# One bucket with two prefixes: audio/ for kept recordings, temp/ for ones
# deleted as soon as they are transcribed.
# Bucket settings: Block all public access ON, and a lifecycle rule deleting
# temp/ after 1 day. See docs/security.md.
S3_BUCKET=
# The bucket's region, e.g. ap-south-1
AWS_REGION=
# IAM -> Users -> your user -> Security credentials -> Create access key.
# That user needs, on this bucket only: PutObject, GetObject, DeleteObject,
# AbortMultipartUpload, ListMultipartUploadParts, ListBucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# OPTIONAL - every one of these has a default that works
# ============================================================================

# --- Payments ---------------------------------------------------------------
# What RevenueCat sends in a webhook's Authorization header, from
# app.revenuecat.com -> Project -> Integrations -> Webhooks.
# Empty means billing events are refused: an event we cannot verify must never
# change a plan. Nothing else about payments is a server setting - Google takes
# the money, and the app's SDK key is a build flag.
REVENUECAT_WEBHOOK_SECRET=

# --- Only for the Neon CLI --------------------------------------------------
# console.neon.tech -> Account settings -> API keys. The server never reads it.
NEON_API_KEY=

# --- Limits: what keeps the server up under a flood -------------------------
# Why each number is what it is: docs/load.md

# Calls per minute from one address, signed in or not. The only limit that
# applies before a token is checked, so it is what stands in front of a script
# with no account.
RATE_LIMIT_PER_IP_PER_MINUTE=120

# Calls per minute per account. Generous for a person, useless for a script.
RATE_LIMIT_PER_MINUTE=60

# Requests in flight before new ones are refused with 503. Refusing beats
# queueing: a queue holds memory and workers until nothing finishes.
MAX_IN_FLIGHT=50

# Largest request body, in bytes. Audio never comes through here - it goes
# straight to S3 with a signed URL - so this only has to fit JSON.
MAX_BODY_BYTES=1048576

# --- Database tuning --------------------------------------------------------
# Neon's free tier has a modest connection budget.
DB_MAX_CONNECTIONS=5

# Seconds to wait for a connection. Short on purpose: a long wait means
# requests pile up behind the pool instead of being refused.
DB_TIMEOUT_SECONDS=2

# How often an account's last_seen_at is actually written. Between writes the
# row is read instead, which costs Postgres far less.
SEEN_WRITE_EVERY_SECONDS=300

# --- Logging ----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# NOT HERE ON PURPOSE
# ============================================================================
#
# PostHog: the app's analytics key is a BUILD flag, not a server setting, and
# it is public by design (it can only write events):
#
#     flutter run --dart-define=POSTHOG_KEY=phc_xxx
#
# An EU project also needs --dart-define=POSTHOG_HOST=https://eu.i.posthog.com
# See ../app/docs/analytics.md.
#
# Behind a proxy: the per-address limit reads the connection's address, so
# uvicorn must be told which peer may rewrite it:
#
#     uvicorn app.main:app --forwarded-allow-ips="<the proxy's address>"
#
# Without that, every request looks like it came from the proxy and they all
# share one allowance. See docs/load.md.
